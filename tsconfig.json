{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "retired",
    "lib/firebase",
    "lib/auth",
    "lib/data",
    "lib/server",
    "lib/config.ts",
    "scripts",
    "tests/support/fakeFirestore.ts",
    "components/AppBar.tsx",
    "components/DemoTools.tsx",
    "components/RequireAuth.tsx",
    "lib/domain/actions.ts"
  ]
}
