# Dividendii "Check my dividends" app. Copy these into Vercel > Project > Settings > Environment Variables.
# Step by step: CHECK-SETUP.md

# Records (Supabase free plan). Run supabase/pilot.sql once in the Supabase SQL Editor first.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Who may open /check/admin. Each also needs a user in Supabase > Authentication > Users. Comma separated.
PILOT_ADMIN_EMAILS=

# "test" (default): every registrar email goes to PILOT_TEST_EMAIL, not the registrar. Switch to "live" only when you are ready.
PILOT_MODE=test
PILOT_TEST_EMAIL=
PILOT_ADMIN_EMAIL=
PILOT_REPLY_TO=support@dividendii.com

# Email check on step 1. "demo" (default): code is always 123456 and no email is sent. "email": a random code is emailed.
PILOT_OTP=demo
# Any long random string (32+ characters). Required when PILOT_MODE=live.
PILOT_SECRET=

# Outgoing mail. A mailbox on your own Qserver hosting works and costs nothing extra (see CHECK-SETUP.md).
MAIL_FROM="Dividendii <support@dividendii.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
