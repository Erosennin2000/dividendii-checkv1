# Dividendii "Check my dividends" app. Copy these into Vercel > Project > Settings > Environment Variables.
# Step by step: CHECK-SETUP.md

# Records (Supabase free plan). Run supabase/pilot.sql once in the Supabase SQL Editor first.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Who may open /check/admin. Each also needs a user in Supabase > Authentication > Users. Comma separated.
PILOT_ADMIN_EMAILS=

# "test" (default): every registrar email goes to PILOT_TEST_EMAIL, not the registrar. Switch to "live" only when you are ready.
PILOT_MODE=test
PILOT_TEST_EMAIL=
PILOT_ADMIN_EMAIL=
PILOT_REPLY_TO=support@dividendii.com

# Email check on step 1. "demo" (default while testing): code is always 123456 and no email is sent. "email": a random code is emailed.
# Once PILOT_MODE=live (or a live Paystack key is set) a random code is ALWAYS emailed and 123456 stops working, whatever this says.
PILOT_OTP=demo
# Any long random string (32+ characters). Required when PILOT_MODE=live.
PILOT_SECRET=

# Outgoing mail. A mailbox on your own Qserver hosting works and costs nothing extra (see CHECK-SETUP.md).
MAIL_FROM="Dividendii <support@dividendii.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Online payment (Paystack). This one key is the switch:
#   leave empty      payments off: forms send without paying, fees are collected by hand
#   sk_test_...      test payments: Paystack test cards work, no real money moves
#   sk_live_...      real payments
# Get it in Paystack > Settings > API Keys & Webhooks. Never put it anywhere but here.
PAYSTACK_SECRET_KEY=
# Bank checks (Monnify). Both keys switch it on; leave empty to switch it off.
#   Account name lookup on step 3: free.
#   BVN and account name match: about N10 per submission, once, after the start fee is paid. It never blocks anyone,
#   and is skipped (shown as "not checked" on the staff page) if your Monnify wallet is empty.
# Find them in Monnify > Developer > API Keys. Use LIVE keys: Monnify's BVN checks work on live only.
# For a free rehearsal of the name lookup alone, use sandbox keys and set MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_BASE_URL=
# The address customers see, used in payment links we email. No trailing slash.
PILOT_PUBLIC_URL=https://www.dividendii.com
